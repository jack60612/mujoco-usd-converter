<mujoco model="world_welded_bodies">
    <worldbody>
        <!-- A rotated static hierarchy, including a trellis-style zero-density wire. -->
        <body name="support" pos="1 2 3" quat="0.7071067811865476 0 0 0.7071067811865476">
            <geom name="support_geom" type="sphere" size="0.02" density="1000"/>
            <!-- A static visual contributes native inferred mass but must not
                 trigger MassAPI on the non-rigid support frame. -->
            <geom name="support_visual" type="sphere" size="0.02" mass="3" contype="0" conaffinity="0"/>
            <body name="e0_wire0" pos="0.3 0.2 0.1">
                <geom name="wire_geom" type="capsule" fromto="0 0 0 0 0.8 0" size="0.008" density="0" contype="2" conaffinity="1"/>
                <site name="e0_tie0_wire" pos="0 0.4 0"/>
            </body>
            <body name="hinged" pos="0 0 0.5">
                <joint name="hinge" type="hinge"/>
                <geom type="sphere" size="0.03" mass="1"/>
            </body>
        </body>
        <body name="branch" pos="0.4 2.3 3.1">
            <freejoint/>
            <geom name="branch_geom" type="sphere" size="0.03" mass="2"/>
            <site name="e0_tie0_branch"/>
            <body name="welded_child" pos="0 0 0.2">
                <geom type="sphere" size="0.02" mass="0.5"/>
            </body>
        </body>
        <body name="mocap" mocap="true" pos="2 0 0">
            <geom type="sphere" size="0.03"/>
            <body name="mocap_child" pos="0 0 0.2">
                <geom type="sphere" size="0.02"/>
            </body>
        </body>
    </worldbody>
    <equality>
        <connect name="tie" site1="e0_tie0_branch" site2="e0_tie0_wire" solref="-1000 -10"/>
        <connect name="tie_reversed" site1="e0_tie0_wire" site2="e0_tie0_branch"/>
        <connect name="body_tie" body1="branch" body2="e0_wire0" anchor="0 0 0"/>
        <connect name="body_tie_reversed" body1="e0_wire0" body2="branch" anchor="0 0.4 0"/>
        <weld name="body_weld" body1="branch" body2="e0_wire0"/>
        <weld name="site_weld" site1="e0_tie0_wire" site2="e0_tie0_branch"/>
    </equality>
</mujoco>
